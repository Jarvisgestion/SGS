# Conexión de la aplicación. IMPORTANTE: NO usar el usuario dueño de las tablas,
# porque el dueño saltea Row Level Security. Usar sgs_web (miembro de sgs_app).
DATABASE_URL=postgres://sgs_web@localhost:5432/sgs_dev
PORT=3000
# Firma los tokens de sesión. En producción, un secreto largo y aleatorio.
SESSION_SECRET=cambiar-en-produccion
