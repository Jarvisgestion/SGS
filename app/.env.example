# Copiar a .env y ajustar según el entorno.
# Desarrollo local: SQLite en un archivo, no requiere instalar nada.
DATABASE_URL="file:./dev.db"

# Producción (ejemplo con Postgres, p. ej. Supabase / Neon / Railway):
# 1. cambiar `provider = "sqlite"` a `provider = "postgresql"` en prisma/schema.prisma
# 2. DATABASE_URL="postgresql://usuario:password@host:5432/nombre_db?sslmode=require"
# 3. correr `npx prisma migrate deploy`
